# Copy the two API keys below into .env.local (never commit .env.local).
# DATABASE_URL is not a secret and lives in .env.

OPENAI_API_KEY="sk-..."
DEEPGRAM_API_KEY="..."
# Local Prisma Postgres dev server (start with: npm run db)
DATABASE_URL="postgres://postgres:postgres@localhost:51214/voice_to_invoice?sslmode=disable&pgbouncer=true"
